[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-r": ["projects::OpenRecent", { "create_new_window": false }],
      "ctrl-r": ["projects::OpenRecent", { "create_new_window": false }],
      "cmd-k cmd-o": "workspace::Open",
      "ctrl-k ctrl-o": "workspace::Open",
      "cmd-shift-s": ["task::Spawn", { "task_name": "Pi: Commit and push staged changes" }],
      "ctrl-shift-s": ["task::Spawn", { "task_name": "Pi: Commit and push staged changes" }],
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-d": "editor::ToggleComments",
      "ctrl-d": "editor::ToggleComments",
    },
  },
  {
    "context": "Editor && extension == scad",
    "bindings": {
      "f5": ["task::Spawn", { "task_name": "OpenSCAD: Preview" }],
    },
  },
]
