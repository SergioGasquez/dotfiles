// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "title_bar": {
    "show_menus": true,
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "agent": {
    "enabled": false,
    "dock": "right"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "file_types": {
    "GitHub Actions": [".github/workflows/*.yml", ".github/workflows/*.yaml"],
  },
  "ui_font_size": 16,
  "buffer_font_family": "Consolas",
  "buffer_font_fallbacks": ["Courier New"],
  "buffer_font_size": 14,
  "buffer_line_height": { "custom": 1.35 },
  "text_rendering_mode": "grayscale",
  "terminal": {
    "starts_open": true,
    "copy_on_select": true,
    "font_family": "Hack Nerd Font",
    "font_size": 14,
  },
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "VSCode Dark Modern",
  },
  "theme_overrides": {
    "VSCode Dark Modern": {
      "syntax": {
        "title": {
          "color": "#569cd6",
          "font_weight": 700,
        },
        "title.markup": {
          "color": "#569cd6",
          "font_weight": 700,
        },
        "link_text": {
          "color": "#5ac1fe",
        },
        "link_text.markup": {
          "color": "#5ac1fe",
        },
      },
    },
  },
  "windows": {
    "terminal": {
      "shell": {
        "program": "powershell.exe",
      },
    },
  },
}
