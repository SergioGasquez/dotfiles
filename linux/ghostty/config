# Nord colors, matching linux/alacritty.toml
background = #2e3440
foreground = #d8dee9
cursor-color = #d8dee9
cursor-text = #2e3440
cursor-style = block
cursor-style-blink = false
selection-background = #4c566a
selection-foreground = cell-foreground
search-background = #88c0d0
search-foreground = cell-background

palette = 0=#3b4252
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#81a1c1
palette = 5=#b48ead
palette = 6=#88c0d0
palette = 7=#e5e9f0
palette = 8=#4c566a
palette = 9=#bf616a
palette = 10=#a3be8c
palette = 11=#ebcb8b
palette = 12=#81a1c1
palette = 13=#b48ead
palette = 14=#8fbcbb
palette = 15=#eceff4

font-family = Hack Nerd Font
font-size = 12
command = /usr/bin/fish

gtk-single-instance = true
quit-after-last-window-closed = false
confirm-close-surface = false

copy-on-select = clipboard
app-notifications = no-clipboard-copy

keybind = alt+backspace=text:\x1b\x7f

window-decoration = client
window-padding-x = 15
window-padding-y = 15
resize-overlay = never

shell-integration-features = no-cursor,title,ssh-env,ssh-terminfo,path
