[general]
"common/gitconfig" = "$HOME/.gitconfig"
"common/rust/config.toml" = "$HOME/.cargo/config.toml"
"common/pi/settings.json" = "$HOME/.pi/agent/settings.json"
"common/pi/skills" = "$HOME/.pi/agent/skills"
"common/pi/scripts" = "$HOME/.pi/agent/scripts"
"common/pi/extensions" = "$HOME/.pi/agent/extensions"
"common/pi/themes" = "$HOME/.pi/agent/themes"
"common/pi/AGENTS.md" = "$HOME/.pi/agent/AGENTS.md"
# "mediaserver/pi/skills/media-server-repro" = "$HOME/.agents/skills/media-server-repro"
"common/agents/espressif/AGENTS.md" = "$HOME/Documents/Espressif/AGENTS.md"
"common/agents/crimpdeq/AGENTS.md" = "$HOME/Documents/Crimpdeq/AGENTS.md"

[windows]
# Prompt
"windows/shell/Microsoft.PowerShell_profile.ps1" = "$HOME/Documents/WindowsPowerShell/Microsoft.PowerShell_profile.ps1"
# Terminal
"windows/terminal/settings.json" = "$APPDATA/Local/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState/settings.json"
# Zed
"common/zed/settings.json" = "$APPDATA/Zed/settings.json"
"common/zed/keymap.json" = "$APPDATA/Zed/keymap.json"
"common/zed/tasks.json" = "$APPDATA/Zed/tasks.json"

[linux]
# Fish
"common/shell/config.fish" = "$HOME/.config/fish/config.fish"
"linux/shell/platform.fish" = "$HOME/.config/fish/conf.d/platform.fish"
"common/shell/aliases.fish" = "$HOME/.config/fish/aliases.fish"
"common/shell/espup_env.fish" = "$HOME/.config/fish/conf.d/espup_env.fish"
"common/shell/esprs.fish" = "$HOME/.config/fish/functions/esprs.fish"
## Completions
"common/shell/espup.fish" = "$HOME/.config/fish/completions/espup.fish"
"common/shell/espflash.fish" ="$HOME/.config/fish/completions/espflash.fish"
# probe-rs
"common/probe-rs/probe-rs.toml" = "$HOME/.probe-rs.toml"
# Terminal
"common/ghostty/config" = "$HOME/.config/ghostty/config"
# Zed
"common/zed/settings.json" = "$HOME/.config/zed/settings.json"
"common/zed/keymap.json" = "$HOME/.config/zed/keymap.json"
"common/zed/tasks.json" = "$HOME/.config/zed/tasks.json"
# Cursor
"common/cursor/settings.json" = "$HOME/.config/Cursor/User/settings.json"
"common/cursor/keybindings.json" = "$HOME/.config/Cursor/User/keybindings.json"
"common/cursor/tasks.json" = "$HOME/.config/Cursor/User/tasks.json"

[darwin]
# Zsh
# "mediaserver/shell/zshrc" = "$HOME/.zshrc"
# Fish
"common/shell/config.fish" = "$HOME/.config/fish/config.fish"
"mac-os/shell/platform.fish" = "$HOME/.config/fish/conf.d/platform.fish"
"common/shell/aliases.fish" = "$HOME/.config/fish/aliases.fish"
"common/shell/espup_env.fish" = "$HOME/.config/fish/conf.d/espup_env.fish"
"common/shell/esprs.fish" = "$HOME/.config/fish/functions/esprs.fish"
## Completions
"common/shell/espup.fish" = "$HOME/.config/fish/completions/espup.fish"
"common/shell/espflash.fish" ="$HOME/.config/fish/completions/espflash.fish"
# probe-rs
"common/probe-rs/probe-rs.toml" = "$HOME/.probe-rs.toml"
# Terminal
"common/ghostty/config" = "$HOME/.config/ghostty/config"
# Zed
"common/zed/settings.json" = "$HOME/.config/zed/settings.json"
"common/zed/keymap.json" = "$HOME/.config/zed/keymap.json"
"common/zed/tasks.json" = "$HOME/.config/zed/tasks.json"
# Cursor
"common/cursor/settings.json" = "$HOME/Library/Application Support/Cursor/User/settings.json"
"common/cursor/keybindings.json" = "$HOME/Library/Application Support/Cursor/User/keybindings.json"
"common/cursor/tasks.json" = "$HOME/Library/Application Support/Cursor/User/tasks.json"
